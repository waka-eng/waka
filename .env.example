# Copy to `.env.local` and replace placeholder secrets as needed.
# The non-secret defaults below match `.env.development` so `sst dev`
# sees the same variable names without any manual additions or renames.

# Database
DATABASE_URL=postgresql://user:password@project.neon.tech/waka?sslmode=require

# Auth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-api-key
GEMINI_API_KEY=replace-with-gemini-api-key-if-llm-provider-is-gemini

# Deployment
AWS_REGION=us-east-1

# App URL
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# CLI Auth
WAKA_API_KEY=replace-with-generated-api-key
