+async function transcribeWithVoxtral(input: {
+  bytes: Uint8Array; apiKey: string; fetchFn?: typeof fetch; signal?: AbortSignal;
+}, media: Awaited<ReturnType<typeof inspectTranscriptionAudio>>) {
+  const provider = openRouterPrivacyPreferences();
+  const formats: Record<string, string> = { 'audio/wav': 'wav', 'audio/webm': 'webm', 'audio/ogg': 'ogg', 'audio/mp4': 'm4a', 'audio/mpeg': 'mp3' };
+  const started = performance.now();
+  let response: Response;
+  try {
+    response = await fetchModelWithTimeout(input.fetchFn ?? fetch, OPENROUTER_TRANSCRIPTION_URL, {
+      method: 'POST', headers: buildOpenRouterHeaders(input.apiKey), signal: input.signal,
+      body: JSON.stringify({ model: AUDIO_TRANSCRIPTION_MODEL,
+        input_audio: { data: Buffer.from(input.bytes).toString('base64'), format: formats[media.mimeType] },
+        response_format: 'json', temperature: 0, ...(Object.keys(provider).length ? { provider } : {}),
+      }),
+    });
+  } catch {
+    recordModelUsage('openrouter', 'audio transcription', null, performance.now() - started, 'unknown');
+    throw new AudioTranscriptionError(input.signal?.aborted ? 'transcription_canceled' : 'transcription_transport_failed', !input.signal?.aborted);
+  }
+  let body: unknown;
+  try { body = await response.json(); } catch {
+    recordModelUsage('openrouter', 'audio transcription', null, performance.now() - started, response.ok ? 'unknown' : 'http_error');
+    if (!response.ok) throw new AudioTranscriptionError(`transcription_http_${response.status}`,
+      response.status === 408 || response.status === 429 || response.status >= 500);
+    throw new AudioTranscriptionError('transcription_invalid_response', true);
+  }
+  recordModelUsage('openrouter', 'audio transcription', body, performance.now() - started, response.ok ? 'received' : 'http_error');
+  if (input.signal?.aborted) throw new AudioTranscriptionError('transcription_canceled', false);
+  if (!response.ok) throw new AudioTranscriptionError(`transcription_http_${response.status}`,
+    response.status === 408 || response.status === 429 || response.status >= 500);
+  const parsed = z.object({ text: z.string().max(MAX_TRANSCRIPT_CHARS),
+    error: z.unknown().optional(), finish_reason: z.string().nullish() }).safeParse(body);
+  if (!parsed.success || parsed.data.error !== undefined) throw new AudioTranscriptionError('transcription_invalid_output', true);
+  if (parsed.data.finish_reason && parsed.data.finish_reason !== 'stop') throw new AudioTranscriptionError('transcription_incomplete', true);
+  return { ...media, model: AUDIO_TRANSCRIPTION_MODEL, transcript: parsed.data.text.trim() };
+}
