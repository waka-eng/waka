{
  "name": "@waka/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes/auth": "./src/routes/auth.ts",
    "./lib/auth": "./src/lib/auth.ts",
    "./db": "./src/db/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "nightly": "tsx src/nightly-local.ts",
    "test": "node scripts/check-vocabulary.mjs && vitest run",
    "test:unit": "node scripts/check-vocabulary.mjs && vitest run --config vitest.unit.config.ts",
    "eval:judge": "WAKA_RUN_LIVE_EVALS=1 vitest run test/judge-eval.test.ts",
    "test:watch": "vitest",
    "vocabulary": "node scripts/check-vocabulary.mjs",
    "eval:extraction": "WAKA_RUN_LIVE_EVALS=1 vitest run test/extraction-eval.test.ts",
    "eval:pipeline": "WAKA_RUN_LIVE_EVALS=1 vitest run test/pipeline-eval.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@hono/node-server": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
