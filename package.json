{
  "name": "waka2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "description": "WAKA inspirations: SST + Hono + Vite/React multi-user app over Neon Postgres.",
  "scripts": {
    "dev": "sst dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:admin": "pnpm --filter @waka/admin dev",
    "build:admin": "pnpm --filter @waka/admin build",
    "typecheck:admin": "pnpm --filter @waka/admin typecheck",
    "test:dev-local-script": "bash -n scripts/dev-local.sh && WAKA_DEV_LOCAL_DRY_RUN=1 bash scripts/dev-local.sh",
    "dev:boot": "tsx tools/dev-stack/boot-and-wait.ts",
    "deploy": "sst deploy",
    "sst": "sst",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "demo:seed": "tsx tools/seed-demo.ts",
    "visual-diff": "tsx tools/visual-diff/capture.ts",
    "visual-diff:install": "playwright install chromium",
    "e2e:smoke": "tsx tools/e2e/smoke.ts",
    "e2e:smoke:boot": "tsx tools/dev-stack/boot-and-wait.ts -- pnpm tsx tools/e2e/smoke.ts",
    "e2e:organic-wow": "tsx tools/e2e/organic-wow.ts",
    "e2e:organic-wow:boot": "tsx tools/dev-stack/boot-and-wait.ts -- pnpm tsx tools/e2e/organic-wow.ts",
    "qa:wow-detail:signed-in": "tsx tools/e2e/wow-detail-signed-in.ts",
    "qa:wow-detail:signed-in:boot": "tsx tools/dev-stack/boot-and-wait.ts --boot-cmd \"pnpm dev:local\" --api-url http://localhost:3010 --web-url http://localhost:3010 -- pnpm tsx tools/e2e/wow-detail-signed-in.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.48.2",
    "sst": "^4.15.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12"
    }
  }
}
