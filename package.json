{
  "name": "waka2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "description": "WAKA inspirations: SST + Hono + Vite/React multi-user app over Neon Postgres.",
  "scripts": {
    "dev": "sst dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:drain": "bash scripts/dev-drain.sh",
    "dev:admin": "pnpm --filter @waka/admin dev",
    "build:admin": "pnpm --filter @waka/admin build",
    "typecheck:admin": "pnpm --filter @waka/admin typecheck",
    "test:dev-local-script": "bash -n scripts/dev-local.sh && WAKA_DEV_LOCAL_DRY_RUN=1 bash scripts/dev-local.sh",
    "dev:boot": "tsx tools/dev-stack/boot-and-wait.ts",
    "deploy": "sst deploy",
    "sst": "sst",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "demo:seed": "tsx tools/seed-demo.ts",
    "demo:world": "tsx tools/demo/seed.ts",
    "e2e:organic": "tsx tools/e2e/organic.ts",
    "e2e:first-paint": "tsx tools/e2e/first-paint.ts",
    "e2e:journeys": "tsx tools/e2e/journeys.ts",
    "e2e:measure": "tsx tools/e2e/measure.ts",
    "e2e:erasure": "tsx tools/e2e/erasure.ts",
    "e2e:connections": "tsx tools/e2e/connections.ts",
    "e2e:rooms": "tsx tools/e2e/rooms.ts",
    "e2e:cold-start": "tsx tools/e2e/cold-start.ts",
    "e2e:signals": "tsx tools/e2e/signals.ts",
    "e2e:top-of-mind": "tsx tools/e2e/top-of-mind.ts",
    "e2e:principles": "tsx tools/e2e/principles.ts",
    "e2e:groups": "tsx tools/e2e/groups.ts",
    "e2e:fixtures": "tsx tools/e2e/fixture-server.ts",
    "e2e:s3-stub": "tsx tools/e2e/s3-stub.ts",
    "visual-diff": "tsx tools/visual-diff/capture.ts",
    "visual-diff:install": "playwright install chromium",
    "e2e:phone": "tsx tools/e2e/phone.ts",
    "e2e:usability": "tsx tools/e2e/usability.ts",
    "e2e:dead-css": "tsx tools/e2e/dead-css.ts",
    "e2e:answers-the-hand": "tsx tools/e2e/answers-the-hand.ts",
    "e2e:snapshot": "tsx tools/e2e/computed-snapshot.ts",
    "e2e:when-it-fails": "tsx tools/e2e/when-it-fails.ts",
    "e2e:first-sixty": "tsx tools/e2e/first-sixty.ts",
    "e2e:at-scale": "tsx tools/e2e/at-scale.ts",
    "e2e:by-keyboard": "tsx tools/e2e/by-keyboard.ts",
    "e2e:lighting": "tsx tools/e2e/lighting.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.48.2",
    "sst": "^3.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12"
    }
  }
}
