{
  "name": "waka2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "description": "WAKA inspirations: SST + Hono + Vite/React multi-user app over Neon Postgres.",
  "scripts": {
    "dev": "sst dev",
    "dev:local": "bash scripts/dev-local.sh",
    "test:dev-local-script": "bash -n scripts/dev-local.sh && WAKA_DEV_LOCAL_DRY_RUN=1 bash scripts/dev-local.sh",
    "dev:boot": "tsx tools/dev-stack/boot-and-wait.ts",
    "deploy": "sst deploy",
    "sst": "sst",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "demo:seed": "tsx tools/seed-demo.ts",
    "visual-diff": "tsx tools/visual-diff/capture.ts",
    "visual-diff:install": "playwright install chromium",
    "e2e:smoke": "tsx tools/e2e/smoke.ts",
    "e2e:smoke:boot": "tsx tools/dev-stack/boot-and-wait.ts -- pnpm tsx tools/e2e/smoke.ts"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "playwright": "^1.48.2",
    "sst": "^3.3.40",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  }
}
