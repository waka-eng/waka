generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  workspaces  Workspace[]
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id            String        @id @default(cuid())
  googleSubject String        @unique @map("google_subject")
  email         String        @unique
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  inspirations  Inspiration[]
  clusters      Cluster[]
  connections   Connection[]
  discoveryEvents DiscoveryEvent[]
  apiKeys       ApiKey[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Workspace {
  id          String       @id @default(cuid())
  tenantId    String
  slug        String
  name        String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  memberships Membership[]
  apiKeys     ApiKey[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
}

model Membership {
  tenantId    String
  workspaceId String
  userId      String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace   Workspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([workspaceId, userId])
  @@index([tenantId, workspaceId])
  @@index([tenantId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Inspiration {
  id                 String             @id @default(cuid())
  userId             String
  title              String?
  rawContent         String
  summary            String?
  // Immutable snapshot of the initial capture payload.
  originalTitle      String?
  originalRawContent String
  sourceType         SourceType
  sourceUrl          String?
  sourceMeta         Json?
  // Immutable provider-scoped AI conversation provenance for summary/embedding traceability.
  sourceConversationRef String?
  originalSourceUrl  String?
  originalSourceMeta Json?
  mediaUrl           String?
  // Dedicated voice-note upload reference and metadata.
  audioStorageKey    String?
  audioStorageUrl    String?
  audioMimeType      String?
  audioSizeBytes     Int?
  audioDurationSeconds Float?
  audioTranscriptionStatus String?
  // Dedicated photo upload reference and pending-upload metadata.
  photoStorageKey    String?
  photoStorageUrl    String?
  photoFileName      String?
  photoMimeType      String?
  photoSizeBytes     Int?
  photoUploadStatus  String?
  transcript         String?
  // Dedicated capture-enrichment outputs for OCR/photo analysis persistence.
  ocrText              String?         @map("ocr_text")
  generatedDescription String?         @map("generated_description")
  processingState      Json?           @map("processing_state")
  originalMediaUrl   String?
  originalTranscript String?
  embedding          Unsupported("vector(1536)")?
  tags               String[]
  domain             String?
  mood               String?
  actionability      String?
  enrichmentStatus       String           @default("PENDING")
  enrichmentEnqueuedAt   DateTime?
  enrichmentStartedAt    DateTime?
  enrichmentCompletedAt  DateTime?
  enrichmentFailedAt     DateTime?
  enrichmentAttemptCount Int              @default(0)
  enrichmentMaxAttemptCount Int           @default(3)
  enrichmentLastFailureReason String?
  enrichmentLastFailureRetryability String?
  enrichmentLastError    Json?
  enrichmentFields   Json?
  enrichmentResumeState Json?
  reflectionPrompt  String?
  reflectionAnswer  String?
  reflectionStatus  ReflectionStatus   @default(PENDING)
  parentId          String?
  sourceParentId    String?
  clusterId         String?
  isPublic          Boolean            @default(false)
  shareSlug         String?            @unique
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent            Inspiration?       @relation("InspirationDepth", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  expansions        Inspiration[]      @relation("InspirationDepth")
  sourceParent      Inspiration?       @relation("InspirationSourceDepth", fields: [sourceParentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceExpansions  Inspiration[]      @relation("InspirationSourceDepth")
  cluster           Cluster?           @relation(fields: [userId, clusterId], references: [userId, id], onDelete: SetNull, onUpdate: Cascade)
  connectionsAsSource Connection[]     @relation("ConnectionSource")
  connectionsAsTarget Connection[]     @relation("ConnectionTarget")
  discoveryEvents   DiscoveryEvent[]

  @@unique([userId, id])
  @@unique([userId, sourceType, sourceUrl])
  @@unique([userId, sourceType, mediaUrl])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@index([userId, sourceType, createdAt(sort: Desc)])
  @@index([userId, sourceUrl])
  @@index([userId, sourceConversationRef])
  @@index([userId, mediaUrl])
  @@index([userId, sourceParentId, createdAt(sort: Desc)])
  @@index([userId, enrichmentStatus, enrichmentEnqueuedAt(sort: Desc)])
  @@index([userId, isPublic, deletedAt, createdAt(sort: Desc)])
  @@index([userId, clusterId, createdAt(sort: Desc)])
  @@index([enrichmentStatus, enrichmentEnqueuedAt(sort: Desc)])
  @@index([clusterId, createdAt(sort: Desc)])
  @@index([clusterId, isPublic, deletedAt, createdAt(sort: Desc)])
}

model Cluster {
  id           String        @id @default(cuid())
  userId       String
  label        String
  description  String?
  isPublic     Boolean       @default(false)
  shareSlug    String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inspirations Inspiration[]

  @@unique([userId, id])
  @@index([userId])
  @@index([userId, isPublic, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
}

model Connection {
  id              String      @id @default(cuid())
  userId          String
  sourceId        String
  targetId        String
  similarityScore Float
  explanation     String
  surfacedAt      DateTime    @default(now())
  dismissed       Boolean     @default(false)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source          Inspiration @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  target          Inspiration @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sourceId, targetId])
  @@index([userId, surfacedAt(sort: Desc)])
  @@index([userId, dismissed, surfacedAt(sort: Desc)])
  @@index([userId, sourceId, surfacedAt(sort: Desc)])
  @@index([userId, targetId, surfacedAt(sort: Desc)])
}

model DiscoveryEvent {
  id                String             @id @default(cuid())
  userId            String
  inspirationId     String
  eventType         DiscoveryEventType
  previousClusterId String
  newClusterId      String
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inspiration       Inspiration        @relation(fields: [userId, inspirationId], references: [userId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, eventType, createdAt(sort: Desc)])
  @@index([userId, inspirationId, createdAt(sort: Desc)])
  @@index([userId, previousClusterId, createdAt(sort: Desc)])
  @@index([userId, newClusterId, createdAt(sort: Desc)])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String
  workspaceId String
  name        String
  description String?
  keyPrefix   String
  metadata    Json?
  hashedKey   String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace   Workspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([tenantId, workspaceId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, revokedAt, createdAt(sort: Desc)])
  @@index([userId, workspaceId, revokedAt, createdAt(sort: Desc)])
  @@index([userId, workspaceId, lastUsedAt(sort: Desc)])
}

enum SourceType {
  CLI_CONVERSATION
  VOICE_NOTE
  TEXT_NOTE
  URL_IMPORT
  PHOTO
  AI_CONVERSATION
}

enum ReflectionStatus {
  PENDING
  PROMPTED
  ANSWERED
  SKIPPED
  NOT_NEEDED
}

enum DiscoveryEventType {
  CLUSTER_REASSIGNED
}
